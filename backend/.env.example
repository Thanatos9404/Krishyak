# Krishyak Backend Environment Variables
# Copy this file to .env and fill in the values

# ==============================================================================
# REQUIRED VARIABLES
# ==============================================================================

# API Security
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Allowed Origins for CORS (comma-separated)
# Example: https://krishyak.vercel.app,https://krishyak.gov.in
CORS_ORIGINS=http://localhost:3000

# ==============================================================================
# OPTIONAL API KEYS
# ==============================================================================

# Plant.ID API Key for disease detection
# Get your free API key from: https://plant.id (100 free credits on signup)
PLANTID_API_KEY=

# OpenWeather API Key for weather integration
# Get your free API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# ==============================================================================
# RATE LIMITING
# ==============================================================================

# Maximum requests per minute per IP
RATE_LIMIT_PER_MINUTE=60

# Maximum requests per day per IP
RATE_LIMIT_PER_DAY=1000

# ==============================================================================
# LOGGING
# ==============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json, text
LOG_FORMAT=json

# ==============================================================================
# DEPLOYMENT
# ==============================================================================

# Environment: development, staging, production
ENVIRONMENT=development

# V2 accounts stay explicitly unavailable until configured. No mock production login.
KRISHYAK_V2_ENABLED=false
V2_DATABASE_URL=
V2_AUTH_SECRET=
V2_OTP_PROVIDER=disabled
# Development-only synthetic test mobiles, never sent SMS; code 123456.
V2_DEV_MOBILES=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
V2_STORAGE_PROVIDER=local
V2_STORAGE_ROOT=
V2_S3_BUCKET=
V2_S3_ENDPOINT=
# Standard AWS SDK credential chain; never expose values to the frontend.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
V2_REDIS_URL=
V2_IMAGE_RETENTION_DAYS=365
V2_AUDIT_RETENTION_DAYS=180
# Disabled until the operator approves provider terms and bounded pilot usage.
V2_SATELLITE_SCHEDULE_ENABLED=false
V2_SATELLITE_SCHEDULE_PLOTS_PER_DAY=10

# API version prefix
API_VERSION=v1

# Enable debug mode (DO NOT enable in production)
DEBUG=false

# Sarvam: server-only speech and one-time locale generation
SARVAM_API_KEY=
SARVAM_IP_PER_MINUTE=6
SARVAM_IP_PER_DAY=60
SARVAM_GLOBAL_PER_MINUTE=20
SARVAM_GLOBAL_PER_DAY=300
SARVAM_TTS_CHARACTERS_PER_DAY=200000
SARVAM_MAX_CONCURRENT=3
# Private v2 speech uses atomic Redis budgets, distinct from legacy endpoints.
# Reserve a maximum 30 seconds per accepted recording; never persist audio.
SARVAM_STT_SECONDS_DAILY=3000
SARVAM_TTS_CHARACTERS_DAILY=50000
V2_TTS_USER_CHARACTERS_DAILY=10000
# Bhashini ULCA pipeline credentials, issued only after actual approval.
# Public documented access is PoC; production additionally requires approval.
BHASHINI_TTS_ENABLED=false
BHASHINI_PRODUCTION_APPROVED=false
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=
# Continuous worker default: fail readiness after 10 minutes without heartbeat.
# For a verified managed batch runner, match its documented cadence and alert
# on missed runs. Example: 15-minute runner, 35-minute staleness = 2100 seconds.
V2_WORKER_STALE_SECONDS=600
# Field Intelligence: server-only CDSE OAuth credentials. Existing app works without them.
REMOTE_SENSING_ENABLED=false
REMOTE_SENSING_PROVIDER=cdse
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Reserved; no economic influence is implemented even if set true.
REMOTE_SENSING_DECISION_INFLUENCE=false
REMOTE_SENSING_MAX_AREA_HA=500
REMOTE_SENSING_CACHE_TTL=3600
REMOTE_SENSING_IMAGE_TTL=1800
REMOTE_SENSING_IP_PER_MINUTE=6
REMOTE_SENSING_IP_PER_DAY=60
REMOTE_SENSING_GLOBAL_PER_DAY=300
# Public Nominatim is for a small single-worker pilot; replicas need shared 1/s pacing.
REMOTE_SENSING_PLACE_LOOKUP_ENABLED=false

# Consent-gated public farm context. Keys remain server-only.
FARM_CONTEXT_NOMINATIM_ENABLED=false
# Enable only after IMD confirms permitted access/authentication for this server.
FARM_CONTEXT_IMD_APPROVED=false
# Publisher REST service is paused. Keep disabled until independently verified.
FARM_CONTEXT_SOILGRIDS_ENABLED=false
FARM_CONTEXT_BHUVAN_ENABLED=true
# Reuses the existing DATA_GOV_IN_API_KEY setting above.

# Optional MeriPehchaan DigiLocker member login, without document access.
# All values must come from approved partner onboarding, never sample tokens.
MERIPEHCHAAN_ENABLED=false
MERIPEHCHAAN_PARTNER_APPROVED=false
MERIPEHCHAAN_CLIENT_ID=
MERIPEHCHAAN_CLIENT_SECRET=
MERIPEHCHAAN_REDIRECT_URI=
MERIPEHCHAAN_ISSUER=
MERIPEHCHAAN_PUBLIC_KEY_PEM=
# Use a durable path shared by workers on the same host.
# SARVAM_QUOTA_DB=/var/lib/krishyak/speech_quotas.sqlite3
