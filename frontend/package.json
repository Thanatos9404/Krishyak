{
  "name": "krishyak-product",
  "version": "2.0.0",
  "private": true,
  "dependencies": {
    "axios": "^1.6.2",
    "chart.js": "^4.4.0",
    "framer-motion": "14.0.0",
    "lucide-react": "1.51.0",
    "maplibre-gl": "6.11.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "19.3.0",
    "recharts": "^2.10.3",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "node scripts/start-production.mjs",
    "build": "npm run lint && next build",
    "preview": "node scripts/start-production.mjs",
    "test": "jest",
    "lint": "eslint src",
    "test:e2e": "playwright test",
    "format:v2": "prettier --write src/features/farms e2e public/sw.js playwright.config.mjs",
    "format:check:v2": "prettier --check src/app src/design src/lib src/components/public src/components/product src/features/product src/features/farms e2e public/sw.js next.config.mjs src/proxy.js playwright.config.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "prebuild": "node scripts/prepare-runtime.mjs",
    "format": "prettier --write src/app src/design src/lib src/components/public src/components/product src/features/product src/features/farms e2e public/sw.js next.config.mjs src/proxy.js playwright.config.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "autoprefixer": "^10.4.16",
    "babel-jest": "30.5.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jest": "30.5.1",
    "jest-environment-jsdom": "30.5.1",
    "lighthouse": "13.5.0",
    "postcss": "^8.4.32",
    "prettier": "^3.9.9",
    "tailwindcss": "4.3.3"
  },
  "engines": {
    "node": ">=22.19"
  }
}
