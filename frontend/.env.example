# Copy to frontend/.env.local for local development. Never commit real values.

# FastAPI origin that src/proxy.js forwards /api/v2/* and /api/public/* to.
# Defaults to http://127.0.0.1:8000 locally and https://krishyak-api.vercel.app on Vercel.
KRISHYAK_API_ORIGIN=http://127.0.0.1:8000

# Shared HMAC key for the signed x-krishyak-client header. Must match the API's value.
KRISHYAK_PROXY_SECRET=

# Only for protected Vercel previews: deployment-protection bypass for the API project.
KRISHYAK_API_PROTECTION_BYPASS=

# Set to "staging" to add noindex headers outside production.
KRISHYAK_DEPLOYMENT=

# Legacy widgets read these public values; next.config.mjs pins them, so leave as is.
REACT_APP_API_URL=/api/public
# Public basemap style only. Never put CDSE credentials in frontend variables.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
